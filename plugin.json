      "content/worlds/*.json"
    ],
    "lorebooks": [
      "content/lorebooks/*.json"
    ],
    "map_definitions": [
      "maps/definitions/*.json"
    ],
    "map_locations": [
      "maps/locations/*.json"
    ]
  },
  "docs": "README.md"
}
